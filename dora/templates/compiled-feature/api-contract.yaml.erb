openapi: 3.0.3
info:
  title: Generated {{entity}} feature contract
  version: 0.1.0
paths:
  {{path}}:
    {{method}}:
      operationId: {{operation_id}}
      x-request-fields: [{{request_fields}}]
      x-response-fields: [{{response_fields}}]
      requestBody:
        required: true
      responses:
        '200': {description: Declared success response}
components:
  schemas:
    {{entity}}:
      type: object
      required: [{{required}}]
      properties:
{{properties}}
