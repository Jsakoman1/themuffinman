#!/usr/bin/env zsh

# Owner-local Dora Bridge launcher. This file is installed only by the explicit
# local adapter; it neither accepts remote input nor configures an OS service.
set -euo pipefail

readonly workspace_root="__DORA_WORKSPACE_ROOT__"
readonly doomsday_root="__DOOMSDAY_ROOT__"
readonly dora_cli_root="$workspace_root/dora/bin"
readonly dora_cli="$dora_cli_root/dora"
readonly codex_bin="$HOME/.local/bin/codex"
readonly runtime_helper="$HOME/.local/libexec/dora-bridge-runtime"
readonly handoff_resolver="$workspace_root/dora/bridge/bin/dora-bridge-codex-both-contract"
readonly preclaimed_contract="$workspace_root/dora/bridge/bin/dora-bridge-codex-both-preclaimed-contract"
readonly handoff_registry="$HOME/.config/dora-bridge/projects.yaml"
readonly handoff_state_root="$HOME/.local/share/dora-bridge"
readonly launcher_preflight_exit=70
readonly codex_execution_failure_exit=71

runner_preflight_fail() {
  print -u2 "Dora Bridge runner launcher preflight failed. Codex will not start."
  exit "$launcher_preflight_exit"
}

[[ -d "$doomsday_root" ]] || runner_preflight_fail
[[ -x "$codex_bin" ]] || runner_preflight_fail
[[ -x "$runtime_helper" ]] || runner_preflight_fail
"$runtime_helper" ensure || runner_preflight_fail
unset CONTROL_PLANE_API_KEY

if [[ "${1:-}" == "--dora-preclaimed-handoff" ]]; then
  [[ $# -eq 2 ]] || runner_preflight_fail
  handoff_id="$2"
  [[ "$handoff_id" =~ '^handoff-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' ]] || runner_preflight_fail
  claim_json="$(ruby "$preclaimed_contract" "$handoff_registry" "$handoff_state_root" "$handoff_id")" || runner_preflight_fail
  [[ "$(print -r -- "$claim_json" | jq -r '.status // empty' 2>/dev/null)" == "claimed_handoff" ]] || runner_preflight_fail
  handoff_project="$(print -r -- "$claim_json" | jq -r '.project // empty' 2>/dev/null)"
  [[ "$handoff_project" =~ '^[a-z][a-z0-9-]*$' ]] || runner_preflight_fail
  export PATH="$dora_cli_root:$PATH"
  [[ "$(command -v dora 2>/dev/null || true)" == "$dora_cli" ]] && dora help >/dev/null || runner_preflight_fail
  if "$codex_bin" exec -C "$workspace_root" --add-dir "$doomsday_root" --color never "A Dora structured handoff is already claimed by the owner-local runner. Retrieve exactly $handoff_id through the Dora Bridge CLI before inspecting or editing project code: dora handoff-get \"$handoff_registry\" --state-root \"$handoff_state_root\" --project \"$handoff_project\" --id \"$handoff_id\". Do not read or edit handoff store files directly. Follow the normal Dora workflow: run the required preflight, implement the task, verify it with Dora evidence, and report completion or any blocker through Dora."; then
    exit 0
  fi
  exit "$codex_execution_failure_exit"
fi

[[ -x "$handoff_resolver" && -f "$handoff_registry" ]] || { print -u2 "Dora Bridge handoff resolver or private registry is unavailable. Codex will not start."; exit 1; }
handoff_json="$(ruby "$handoff_resolver" "$handoff_registry" "$handoff_state_root" dora doomsday-storage)" || { print -u2 "Dora Bridge handoff resolution failed. Codex will not start."; exit 1; }
handoff_status="$(print -r -- "$handoff_json" | jq -r '.status // empty' 2>/dev/null)"
case "$handoff_status" in
  no_ready_handoff) exec "$codex_bin" -C "$workspace_root" --add-dir "$doomsday_root" "$@" ;;
  ready_handoff)
    handoff_id="$(print -r -- "$handoff_json" | jq -r '.handoff_id // empty' 2>/dev/null)"
    handoff_project="$(print -r -- "$handoff_json" | jq -r '.project // empty' 2>/dev/null)"
    [[ "$handoff_id" =~ '^handoff-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' && "$handoff_project" =~ '^[a-z][a-z0-9-]*$' && $# -eq 0 ]] || { print -u2 "Dora Bridge handoff resolution returned an unsafe state. Codex will not start."; exit 1; }
    export PATH="$dora_cli_root:$PATH"
    [[ "$(command -v dora 2>/dev/null || true)" == "$dora_cli" ]] && dora help >/dev/null || { print -u2 "Dora handoff CLI failed its launcher preflight."; exit 1; }
    exec "$codex_bin" -C "$workspace_root" --add-dir "$doomsday_root" "A Dora structured handoff is pending for project $handoff_project. Retrieve it through Dora's local handoff CLI and claim exactly $handoff_id before inspecting or editing project code: dora handoff-claim \"$handoff_registry\" --state-root \"$handoff_state_root\" --project \"$handoff_project\" --id \"$handoff_id\". Do not read or edit handoff store files directly; then use the normal Dora preflight, work-start, work-verify, and evidence workflow."
    ;;
  *) print -u2 "Dora Bridge handoff resolution returned an unsafe state. Codex will not start."; exit 1 ;;
esac
