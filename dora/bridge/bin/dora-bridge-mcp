#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/dora_bridge/server"

state_root_option = ARGV.index("--handoff-state-root")
state_root = state_root_option && ARGV[state_root_option + 1]
ARGV.slice!(state_root_option, 2) if state_root_option
config_path = ARGV.first
abort "usage: dora-bridge-mcp BRIDGE_PROJECTS.yaml [--handoff-state-root OWNER_LOCAL_DIRECTORY]" unless config_path && ARGV.length == 1 && (!state_root_option || state_root)

handoff_store = state_root ? Dora::Handoff.new(state_root: state_root) : nil
DoraBridge::Server.new(DoraBridge::ProjectRegistry.load!(config_path), handoff_store: handoff_store).run
