#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../../lib/dora/handoff_cli"

registry_path, state_root, handoff_id, *extra = ARGV
abort "usage: dora-bridge-codex-both-preclaimed-contract BRIDGE_PROJECTS.yaml OWNER_LOCAL_STATE_ROOT HANDOFF_ID" unless registry_path && state_root && handoff_id && extra.empty?

registry = DoraBridge::ProjectRegistry.load!(registry_path)
handoff = Dora::Handoff.new(state_root: state_root).get!(id: handoff_id)
registry.handoff_authorized!(handoff.fetch("project"))
abort "handoff is not claimed" unless handoff.fetch("status") == "CLAIMED"
puts JSON.generate({"status" => "claimed_handoff", "project" => handoff.fetch("project"), "handoff_id" => handoff.fetch("id")})
