#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../../lib/dora/handoff_runner"

begin
command = ARGV.shift
registry_path = ARGV.shift
state_root = ARGV.shift
abort "usage: dora-bridge-handoff-runner <watch|run-once|status|stop> BRIDGE_PROJECTS.yaml OWNER_LOCAL_STATE_ROOT --project PROJECT_ID [--project PROJECT_ID] [--interval SECONDS]" unless %w[watch run-once status stop].include?(command) && registry_path && state_root

projects = []
interval = 5
until ARGV.empty?
  flag = ARGV.shift
  value = ARGV.shift
  abort "runner options are invalid" unless value && %w[--project --interval].include?(flag)
  if flag == "--project"
    projects << value
  elsif interval == 5
    interval = value
  else
    abort "runner options are invalid"
  end
end

runner = Dora::HandoffRunner.new(registry_path: registry_path, state_root: state_root, projects: projects)
result = case command
         when "watch" then runner.watch(interval_seconds: interval)
         when "run-once" then runner.run_once
         when "status" then runner.status
         when "stop" then runner.request_stop!
         end
puts JSON.generate(result) if result
rescue Dora::HandoffRunner::Error => error
warn "Dora handoff runner failed; owner review is required."
exit 1
end
