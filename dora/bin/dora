command = ARGV.shift
fail!("--format must be json or yaml") if OUTPUT_FORMAT && !%w[json yaml].include?(OUTPUT_FORMAT)
case command
when "validate-adapter"
  fail!("usage: dora validate-adapter <adapter-path>") unless ARGV.length == 1
  validate_adapter(ARGV.first)
when "validate-work-plan"
  fail!("usage: dora validate-work-plan <adapter-path> <work-plan-path>") unless ARGV.length == 2
  validate_work_plan(ARGV[0], ARGV[1])
when "plan-contract"
  fail!("usage: dora plan-contract <work-plan-path>") unless ARGV.length == 1
  validate_atomic_plan_contract(ARGV.first)
when "plan-coverage"
  fail!("usage: dora plan-coverage <plan-registry-path>") unless ARGV.length == 1
  review_plan_coverage(ARGV.first)
when "plugin-contract"
  fail!("usage: dora plugin-contract <plugin-manifest-path>") unless ARGV.length == 1
  validate_plugin_contract(ARGV.first)
when "plugin-run"
  fail!("usage: dora plugin-run <plugin-manifest-path> <plugin-id>") unless ARGV.length == 2
  run_plugin(ARGV[0], ARGV[1])
when "work-start"
  fail!("usage: dora work-start <adapter-path> plan=<path> task=<id>") if ARGV.length < 3
  execute_work(ARGV.shift, ["action=start", *ARGV])
when "work-verify"
  fail!("usage: dora work-verify <adapter-path> plan=<path> [task=<id>]") if ARGV.length < 2
  execute_work(ARGV.shift, ARGV)
when "idc-envelope"
  fail!("usage: dora idc-envelope <adapter-path> <selector-path>") unless ARGV.length == 2
  export_idc_envelope(ARGV[0], ARGV[1])
when "idc-render"
  render_idc(ARGV)
when "handoff-next"
  execute_handoff("next", ARGV)
when "handoff-get"
  execute_handoff("get", ARGV)
when "handoff-claim"
  execute_handoff("claim", ARGV)
when "handoff-link"
  execute_handoff("link", ARGV)
when "handoff-block"
  execute_handoff("block", ARGV)
when "handoff-feedback"
  execute_handoff("feedback", ARGV)
when "handoff-block-owner-decision"
  execute_handoff("block_owner_decision", ARGV)
when "handoff-complete"
  execute_handoff("complete", ARGV)
when "init"
  destination = ARGV.shift
  project_option = ARGV.index("--project")
  stack_option = ARGV.index("--stack")
  ci_option = ARGV.index("--ci")
  commands_option = ARGV.index("--commands")
  project_id = project_option ? ARGV[project_option + 1] : nil
  stack = stack_option ? ARGV[stack_option + 1] : nil
  ci = ci_option ? ARGV[ci_option + 1] : nil
  ci_commands = commands_option ? ARGV[commands_option + 1] : nil
  expected_length = 2 + (stack_option ? 2 : 0) + (ci_option ? 2 : 0) + (commands_option ? 2 : 0)
  fail!("usage: dora init <destination> --project <project-id> [--stack <stack-id>] [--ci <ci-id> --commands <project-commands.yaml>]") unless destination && project_option && ARGV.length == expected_length && project_id && (!stack_option || stack) && (!ci_option || ci) && (ci_option ? commands_option && ci_commands : !commands_option)
  initialize_project(destination, project_id, stack, ci, ci_commands)
when "new"
  destination = ARGV.shift
  answers_option = ARGV.index("--answers")
  answers_path = answers_option ? ARGV[answers_option + 1] : nil
  fail!("usage: dora new <destination> --answers <project-new.yaml>") unless destination && answers_option == 0 && ARGV.length == 2 && answers_path
  create_project_from_answers(destination, answers_path)
when "create-app"
  destination = ARGV.shift
  bundle_option = ARGV.index("--bundle")
  bundle_path = bundle_option ? ARGV[bundle_option + 1] : nil
  interview_option = ARGV.index("--interview")
  source_option = ARGV.index("--source")
  if bundle_option
    fail!("usage: dora create-app <destination> --bundle <create-app.yaml> [--format json|yaml]") unless destination && bundle_option == 0 && ARGV.length == 2 && bundle_path
    create_app(destination, bundle_path)
  else
    interview = interview_option && ARGV[interview_option + 1]; source = source_option && ARGV[source_option + 1]
    starter_option = ARGV.index("--starter"); starter = starter_option && ARGV[starter_option + 1]
    codex = ARGV.delete("--codex-integrate")
    fail!("usage: dora create-app <destination> --interview <idea-interview.yaml> --source <bootstrap-source.yaml> [--starter <starter-id>] [--codex-integrate] [--format json|yaml]") unless destination && interview && source && (!starter_option || starter)
    create_app_from_interview(destination, interview, source, starter: starter, codex_integration: !codex.nil?)
  end
when "session-create-app"
  destination = ARGV.shift
  input_option = ARGV.index("--input")
  input_path = input_option && ARGV[input_option + 1]
  preview = ARGV.delete("--preview")
  apply = ARGV.delete("--apply")
  fail!("usage: dora session-create-app <destination> --input <session-create-app.yaml> --preview|--apply [--format json|yaml]") unless destination && input_option == 0 && input_path && (!!preview ^ !!apply)
  create_app_from_session(destination, input_path, preview: !preview.nil?)
when "feature-skeleton"
  fail!("usage: dora feature-skeleton <confirmed-feature-skeleton.yaml> [--format json|yaml]") unless ARGV.length == 1
  preview_feature_skeleton(ARGV.first)
when "compiled-feature-preview"
  fail!("usage: dora compiled-feature-preview <confirmed-compiled-feature.yaml> [--format json|yaml]") unless ARGV.length == 1
  preview_compiled_feature(ARGV.first)
when "architecture-decision"
  log_path = ARGV.shift
  input_option = ARGV.index("--input")
  input_path = input_option && ARGV[input_option + 1]
  fail!("usage: dora architecture-decision <decision-log.yaml> --input <confirmed-decision.yaml> [--format json|yaml]") unless log_path && input_option == 0 && ARGV.length == 2 && input_path
  append_architecture_decision(log_path, input_path)
when "codex-integrate"
  fail!("usage: dora codex-integrate <project-root> [--format json|yaml]") unless ARGV.length == 1
  install_codex_integration(ARGV.first)
when "explain"
