def append_decision_record(path, arguments)
  values = {}
  %w[id decision status domain-ref plan-ref evidence-ref].each do |name|
    index = arguments.index("--#{name}")
    values[name] = index && arguments[index + 1]
  end
  fail!("usage: dora decision-record <log.yaml> --id <id> --decision <text> --status <proposed|accepted|superseded> --domain-ref <path> --plan-ref <path> --evidence-ref <path> [--format json|yaml]") unless values.values.all?
  entry = {"id" => values["id"], "decision" => values["decision"], "status" => values["status"], "domain_references" => [values["domain-ref"]], "plan_references" => [values["plan-ref"]], "evidence_references" => [values["evidence-ref"]]}
  result = Dora::DecisionRecord.append!(path: path, entry: entry)
  return if emit_envelope(result, citations: [File.basename(path)], side_effect: "local_mutation")
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def apply_runtime_profile(destination, dry_run)
  result = Dora::RuntimeProofProfileApply.apply!(destination: destination, dry_run: dry_run)
  return if emit_envelope(result, citations: ["packs/playwright-runtime-proof.yaml"], side_effect: dry_run ? "read_only" : "local_mutation")
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def explain_revision_evidence(trace_path)
  trace = Dora::RevisionEvidenceTrace.validate!(YAML.load_file(trace_path))
  gaps = trace.fetch("unresolved").map { |item| item.fetch("reason") }
  payload = {"kind" => "dora_evidence_explanation", "version" => 1, "capability_id" => trace.fetch("capability_id"), "revision" => trace.fetch("revision"), "changed_paths" => trace.fetch("changed_paths"), "evidenced" => {"validation" => trace.fetch("validation_evidence").select { |item| item.fetch("status") == "recorded" }, "runtime" => trace.fetch("runtime_evidence").select { |item| item.fetch("status") == "recorded" }}, "not_evidenced" => gaps, "citations" => [trace.dig("work", "plan")] + trace.fetch("validation_evidence").map { |item| item.fetch("path") } + trace.fetch("runtime_evidence").map { |item| item.fetch("path") }, "completion_boundary" => "This reports declared revision evidence and explicit gaps only; it does not prove implementation acceptance or release readiness."}
  return if emit_envelope(payload, citations: payload.fetch("citations"))
  puts YAML.dump(payload).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def project_memory(knowledge, first_work, plan_path)
  open_decisions = knowledge.fetch("product_brief").fetch("unanswered_decisions").each_with_index.map do |statement, index|
    {"id" => "open-decision-#{index + 1}", "statement" => statement, "source" => "docs/product-brief.yaml"}
  end
  Dora::ProjectMemory.validate!(
    "kind" => "dora_project_memory",
    "version" => 1,
    "project_intent" => {"product_brief" => "docs/product-brief.yaml", "domain_library" => "docs/domain-library.yaml"},
    "canonical_knowledge" => [
      {"id" => "product", "path" => "docs/product-brief.yaml", "purpose" => "Declared product intent and unresolved decisions."},
      {"id" => "domain", "path" => "docs/domain-library.yaml", "purpose" => "Declared domain rules and workflows."},
      {"id" => "agent", "path" => ".dora/agent-project-profile.yaml", "purpose" => "Declared Codex operating constraints and commands."}
    ],
    "open_decisions" => open_decisions,
    "capability_intent" => [{"id" => first_work.fetch("id"), "intended_outcome" => first_work.fetch("observable_outcome"), "knowledge_references" => ["product", "domain", "agent"]}],
    "current_work" => {"plan" => plan_path, "task" => first_work.fetch("id"), "state" => "planned"}
  )
end

def write_yaml(path, document)
  File.write(path, YAML.dump(document).sub(/\A---\n/, ""))
end

def bootstrap_project(destination, project_id, source_descriptor_path, starter = nil, ci = nil)
  starter_path = starter && File.join(ROOT, "starters", "#{starter}.yaml")
  fail!("unknown starter pack: #{starter}") if starter_path && !File.file?(starter_path)
  ci_path = ci && File.join(ROOT, "packs", "#{ci}.yaml")
  fail!("unknown CI pack: #{ci}") if ci_path && !File.file?(ci_path)
  result = Dora::ProjectBootstrap.bootstrap!(destination, project_id: project_id, source_descriptor_path: source_descriptor_path, starter_pack_path: starter_path, ci_pack_path: ci_path)
  puts "Dora project bootstrapped: #{result.fetch("project_root")} (#{result.fetch("package_path")} pinned to #{result.fetch("source_ref")})."
rescue ArgumentError => error
  fail!(error.message)
end

