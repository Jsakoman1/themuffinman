format_index = ARGV.index("--format")
OUTPUT_FORMAT = if format_index
  value = ARGV[format_index + 1]
  ARGV.slice!(format_index, 2)
  value
end

def fail!(message)
  if defined?(OUTPUT_FORMAT) && %w[json yaml].include?(OUTPUT_FORMAT)
    envelope = Dora::CommandEnvelope.error(message: message, remediation: "Use dora help for the declared command syntax.")
    puts OUTPUT_FORMAT == "json" ? JSON.generate(envelope) : YAML.dump(envelope).sub(/\A---\n/, "")
    exit 1
  end
  warn "Dora adapter validation failed: #{message}"
  exit 1
end

def emit_envelope(payload, citations: [], side_effect: "read_only")
  return unless OUTPUT_FORMAT
  fail!("--format must be json or yaml") unless %w[json yaml].include?(OUTPUT_FORMAT)
  envelope = Dora::CommandEnvelope.success(payload: payload, citations: citations, side_effect: side_effect)
  puts OUTPUT_FORMAT == "json" ? JSON.generate(envelope) : YAML.dump(envelope).sub(/\A---\n/, "")
  true
end

def validate_adapter(path)
  result = Dora::Adapter.validate!(path, SCHEMA_PATH)
  puts "Dora adapter valid: #{result.fetch("project")} (#{result.fetch("extensions")} project extensions)."
rescue ArgumentError => error
  fail!(error.message)
end

def validate_work_plan(adapter_path, plan_path)
  result = Dora::WorkVerifier.validate_plan!(adapter_path, plan_path, SCHEMA_PATH)
  puts "Dora work plan valid: #{result.fetch("project")}##{result.fetch("id")} (#{result.fetch("kind")})."
rescue ArgumentError => error
  fail!(error.message)
end

def validate_atomic_plan_contract(plan_path)
  result = Dora::AtomicPlanContract.validate!(plan_path)
  puts "Dora atomic plan contract valid: #{result.fetch("id")} (#{result.fetch("tasks")} tasks)."
rescue ArgumentError => error
  fail!(error.message)
end

def review_plan_coverage(registry_path)
  Dora::PlanCoverage.review!(registry_path).each { |row| puts "#{row.fetch("id")}: #{row.fetch("status")} (#{row.fetch("path")})" }
rescue ArgumentError => error
  fail!(error.message)
end

def validate_plugin_contract(manifest_path)
  result = Dora::PluginContract.validate!(manifest_path)
  puts "Dora plugin contract valid: #{result.fetch("plugins").join(", ")}."
rescue ArgumentError => error
  fail!(error.message)
end

def run_plugin(manifest_path, plugin_id)
  result = Dora::PluginRunner.run!(manifest_path, plugin_id: plugin_id)
  puts result.fetch("output")
rescue ArgumentError => error
  fail!(error.message)
end

def execute_work(adapter_path, arguments)
  puts Dora::WorkExecution.run(adapter_path: adapter_path, schema_path: SCHEMA_PATH, arguments: arguments)
rescue Dora::WorkExecution::Error, ArgumentError => error
  fail!(error.message)
end

def export_idc_envelope(adapter_path, selector_path)
  selection = Dora::IdcEnvelope.load_selection!(selector_path)
  result = Dora::IdcEnvelope.export!(adapter_path: adapter_path, selection: selection)
  puts OUTPUT_FORMAT == "json" ? JSON.generate(result) : YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def render_idc(arguments)
  options = %w[triage request manifest dossier out]
  pairs = arguments.each_slice(2).to_a
  fail!("usage: dora idc-render --triage <path> --request <path> --manifest <path> --dossier <path> --out <path>") unless arguments.length == 10 && pairs.all? { |pair| pair.length == 2 && pair.first.start_with?("--") && options.include?(pair.first.delete_prefix("--")) } && pairs.map(&:first).uniq.length == options.length
  values = options.to_h { |name| [name, pairs.find { |pair| pair.first == "--#{name}" }.last] }
  result = Dora::IdcOwnerStartedRenderer.run!(triage_path: values.fetch("triage"), request_path: values.fetch("request"), manifest_path: values.fetch("manifest"), dossier_path: values.fetch("dossier"), output_path: values.fetch("out"), root: ROOT)
  return if emit_envelope(result, side_effect: "local_mutation")

  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def initialize_project(destination, project_id, stack = nil, ci = nil, ci_commands = nil)
  manifest = File.join(ROOT, "templates/init-manifest.yaml")
  pack = stack && File.join(ROOT, "packs/#{stack}.yaml")
  ci_pack = ci && File.join(ROOT, "packs/#{ci}.yaml")
  fail!("unknown stack pack: #{stack}") if pack && !File.file?(pack)
  fail!("unknown CI pack: #{ci}") if ci_pack && !File.file?(ci_pack)
  files = Dora::ProjectInitializer.initialize!(destination, project_id: project_id, manifest_path: manifest, stack_pack_path: pack, ci_pack_path: ci_pack, ci_template_path: File.join(ROOT, "templates/github-actions-control.yml"), ci_commands_path: ci_commands)
  puts "Dora project initialized: #{File.expand_path(destination)} (#{files.length} control files)."
rescue ArgumentError => error
  fail!(error.message)
end

def create_project_from_answers(destination, answers_path)
  answers = Dora::ProjectNew.validate!(YAML.load_file(answers_path))
  verified_source = Dora::BootstrapSource.validate!(answers.fetch("dora_source"))
  source = answers.fetch("dora_source").merge("source" => verified_source)
  root = File.expand_path(destination)
  Dora::ProjectInitializer.initialize!(root, project_id: answers.fetch("project_id"), manifest_path: File.join(verified_source.fetch("path"), "templates/init-manifest.yaml"), dora_source: source)
  knowledge = answers.fetch("intake")
  write_yaml(File.join(root, "docs/product-brief.yaml"), knowledge.fetch("product_brief"))
  write_yaml(File.join(root, "docs/domain-library.yaml"), knowledge.fetch("domain_library"))
  write_yaml(File.join(root, ".dora/agent-project-profile.yaml"), knowledge.fetch("agent_profile"))
  first_work = answers.fetch("first_work")
  plan_path = "docs/work/first-work.yaml"
  plan = {"kind" => "work", "version" => 1, "id" => "first-work", "title" => first_work.fetch("title"), "status" => "draft", "baseline" => "pending_git_baseline", "strict_verification" => true, "serial_task_execution" => true, "execution_inventory" => "docs/work/execution-inventory.yaml", "tasks" => [first_work.merge("inventory_item" => first_work.fetch("id"), "dependencies" => [])]}
  inventory = {"kind" => "execution_inventory", "version" => 1, "id" => "first-work", "master_plan" => plan_path, "items" => [{"id" => first_work.fetch("id"), "order" => 1, "plan" => plan_path, "task" => first_work.fetch("id"), "status" => "pending"}]}
  write_yaml(File.join(root, plan_path), plan)
  write_yaml(File.join(root, "docs/work/execution-inventory.yaml"), inventory)
  write_yaml(File.join(root, "docs/project-memory.yaml"), project_memory(knowledge, first_work, plan_path))
  puts "Dora project created: #{root} (reviewed local Dora package, explicit knowledge, and first work declaration; create a Git baseline before work-start)."
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def create_app(destination, bundle_path)
  bundle = Dora::CreateApp.validate!(YAML.load_file(bundle_path))
  root = File.expand_path(destination)
  fail!("create-app destination must be empty") if File.exist?(root) && !Dir.children(root).empty?

  source = Dora::BootstrapSource.validate!(bundle.fetch("dora_source"), base_directory: File.dirname(File.expand_path(bundle_path)))
  source_record = bundle.fetch("dora_source").merge("source" => source)
  Dora::ProjectInitializer.initialize!(root, project_id: bundle.fetch("project_id"), manifest_path: File.join(source.fetch("path"), "templates/init-manifest.yaml"), dora_source: source_record)
  starter_result = if bundle["starter_selection"]
                     Dora::StarterPack.apply!(File.join(source.fetch("path"), bundle.dig("starter_selection", "starter_pack")), project_root: root)
                   end

  knowledge = create_app_knowledge(bundle)
  write_yaml(File.join(root, "docs/product-brief.yaml"), knowledge.fetch("product_brief"))
  write_yaml(File.join(root, "docs/domain-library.yaml"), knowledge.fetch("domain_library"))
  write_yaml(File.join(root, ".dora/agent-project-profile.yaml"), knowledge.fetch("agent_profile"))
  write_yaml(File.join(root, "docs/idea-interview.yaml"), bundle.fetch("interview"))
  write_yaml(File.join(root, "docs/first-capability.yaml"), {"kind" => "dora_first_capability", "version" => 1, "capability" => bundle.fetch("first_capability"), "completion_boundary" => "This is declared capability intent only; it does not prove implementation or acceptance."})

  first_work = bundle.fetch("first_work")
  plan_path = "docs/work/first-work.yaml"
  plan = {"kind" => "work", "version" => 1, "id" => "first-work", "title" => first_work.fetch("title"), "status" => "draft", "baseline" => "pending_git_baseline", "strict_verification" => true, "serial_task_execution" => true, "execution_inventory" => "docs/work/execution-inventory.yaml", "tasks" => [first_work.merge("inventory_item" => first_work.fetch("id"), "dependencies" => [])]}
  inventory = {"kind" => "execution_inventory", "version" => 1, "id" => "first-work", "master_plan" => plan_path, "items" => [{"id" => first_work.fetch("id"), "order" => 1, "plan" => plan_path, "task" => first_work.fetch("id"), "status" => "pending"}]}
  write_yaml(File.join(root, plan_path), plan)
  write_yaml(File.join(root, "docs/work/execution-inventory.yaml"), inventory)
  write_yaml(File.join(root, "docs/capability-package.yaml"), generated_capability_package(bundle, first_work))
  write_yaml(File.join(root, "docs/project-memory.yaml"), project_memory(knowledge, first_work, plan_path))

  integration = bundle.fetch("codex_integration") ? Dora::CodexIntegration.install!(project_root: root) : {"kind" => "dora_codex_integration", "version" => 1, "status" => "not_requested", "authority_boundary" => "Codex integration is opt-in and was not installed."}
  readiness = Dora::ProjectReadiness.report!(project_root: root, initialize_git: true)
  result = {"kind" => "dora_create_app_result", "version" => 1, "project_root" => root, "project_id" => bundle.fetch("project_id"), "git_baseline" => readiness.fetch("baseline"), "starter" => {"requested" => bundle["starter"], "status" => starter_result ? "applied" : "not_requested", "files" => starter_result ? starter_result.fetch("files") : [], "boundary" => "Only the declared neutral technical starter was applied; product logic remains excluded."}, "codex_integration" => integration, "created" => ["dora", ".dora", "docs/product-brief.yaml", "docs/domain-library.yaml", "docs/idea-interview.yaml", "docs/first-capability.yaml", "docs/capability-package.yaml", "docs/work/first-work.yaml", "docs/work/execution-inventory.yaml", "docs/project-memory.yaml"], "preservation_boundary" => "Create-app requires an empty destination and creates only a new Dora project structure. It does not overwrite existing project files or infer business rules.", "completion_boundary" => "Create-app prepares declared project context and a local Git baseline only; it does not implement a capability, resolve decisions, or prove product readiness."}
  return if emit_envelope(result, citations: ["docs/idea-interview.yaml", "docs/first-capability.yaml", "docs/work/first-work.yaml"], side_effect: "local_mutation")

  puts "Dora project created: #{root} (declared knowledge, local Git baseline, and first work declaration)."
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def generated_capability_package(bundle, first_work)
  capability = bundle.fetch("first_capability")
  Dora::CapabilityPackage.validate!("kind" => "dora_capability_package", "version" => 1, "id" => capability.fetch("id"), "title" => capability.fetch("title"), "intent" => {"problem" => bundle.fetch("interview").fetch("answers").find { |answer| answer.fetch("id") == "first_problem" }.fetch("value").to_s, "capability" => capability.fetch("title"), "source_reference" => "docs/idea-interview.yaml"}, "domain" => {"entity_ids" => ["entity-1"], "invariant_ids" => ["declared-permission-intent"], "permission_rule_ids" => ["declared-permission"], "workflow_id" => "declared-workflow"}, "api" => {"service_owner" => "unassigned", "operations" => [{"id" => capability.fetch("id"), "purpose" => capability.fetch("title")} ]}, "tests" => {"scenarios" => [{"id" => "first-capability-test", "action" => "Run a declared validation for #{capability.fetch("title")}.", "expected" => first_work.fetch("observable_outcome"), "status" => "declared"}]}, "runtime" => {"scenarios" => [{"id" => "first-capability-runtime", "action" => "Run the declared capability in a local runtime.", "expected" => first_work.fetch("observable_outcome"), "status" => "unresolved"}]}, "work" => {"plan" => "docs/work/first-work.yaml", "task" => first_work.fetch("id")}, "unresolved" => [{"id" => "first-capability-test", "reason" => "No validation evidence has been recorded."}, {"id" => "first-capability-runtime", "reason" => "No runtime evidence has been recorded."}])
end

def create_app_from_interview(destination, interview_path, source_path, starter: nil, codex_integration: false)
  interview = Dora::IdeaInterview.validate!(YAML.load_file(interview_path))
  descriptor = YAML.load_file(source_path)
  verified_source = Dora::BootstrapSource.validate!(descriptor, base_directory: File.dirname(File.expand_path(source_path)))
  descriptor["source"]["path"] = verified_source.fetch("path")
  first_capability = interview.fetch("answers").find { |answer| answer.fetch("id") == "first_capability" }.fetch("value").to_s
  bundle = {"kind" => "dora_create_app", "version" => 1, "interview" => interview, "dora_source" => descriptor, "first_capability" => {"id" => "first-capability", "title" => first_capability, "interview_answer" => "first_capability"}, "first_work" => {"id" => "prepare-first-capability", "title" => "Prepare declared first capability", "observable_outcome" => "The first capability package is declared without inferred implementation.", "required_paths" => ["docs/capability-package.yaml"], "validation" => "./bin/dora doctor .dora/project.yaml", "evidence_boundary" => ["generated capability package"]}, "starter" => starter, "codex_integration" => codex_integration}
  Dir.mktmpdir("dora-create-app-bundle") do |temporary|
    path = File.join(temporary, "generated-create-app.yaml")
    File.write(path, YAML.dump(bundle))
    create_app(destination, path)
  end
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def create_app_from_session(destination, input_path, preview: false)
  bundle = Dora::SessionCreateApp.convert!(YAML.load_file(input_path))
  if preview
    payload = Dora::SessionCreateApp.preview!(YAML.load_file(input_path)).merge("kind" => "dora_session_create_app_preview", "version" => 1, "completion_boundary" => "Preview creates no project and does not implement a capability.")
    return emit_envelope(payload, citations: [File.basename(input_path)]) || puts(YAML.dump(payload).sub(/\A---\n/, ""))
  end
  Dir.mktmpdir("dora-session-create-app") do |temporary|
    bundle_path = File.join(temporary, "create-app.yaml")
    File.write(bundle_path, YAML.dump(bundle))
    create_app(destination, bundle_path)
  end
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def preview_feature_skeleton(input_path)
  payload = Dora::FeatureSkeleton.preview!(YAML.load_file(input_path))
  citation = input_path.start_with?("/") ? File.basename(input_path) : input_path
  return if emit_envelope(payload, citations: [citation])

  puts YAML.dump(payload).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def preview_compiled_feature(input_path)
  payload = Dora::CompiledFeaturePreview.preview!(YAML.load_file(input_path))
  citation = input_path.start_with?("/") ? File.basename(input_path) : input_path
  return if emit_envelope(payload, citations: [citation])

  puts YAML.dump(payload).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def append_architecture_decision(log_path, input_path)
  result = Dora::ArchitectureDecision.append!(path: log_path, entry: YAML.load_file(input_path))
  citation = log_path.start_with?("/") ? File.basename(log_path) : log_path
  return if emit_envelope(result, citations: [citation], side_effect: "local_mutation")

  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def create_app_knowledge(bundle)
  answers = bundle.fetch("interview").fetch("answers").to_h { |row| [row.fetch("id"), row.fetch("value")] }
  decisions = bundle.fetch("interview").fetch("unanswered_decisions").map { |decision| decision.fetch("question") }
  concepts = Array(answers.fetch("domain_concepts")).map(&:to_s)
  users = Array(answers.fetch("target_users")).map(&:to_s)
  capability = bundle.fetch("first_capability")
  first_work = bundle.fetch("first_work")

  {
    "product_brief" => {"kind" => "dora_product_brief", "version" => 1, "product" => bundle.fetch("project_id"), "user_problem" => answers.fetch("first_problem").to_s, "primary_users" => users, "intended_outcomes" => [capability.fetch("title")], "non_goals" => Array(answers.fetch("forbidden_outcomes")).map(&:to_s), "assumptions" => ["No additional product assumptions were declared in the idea interview."], "risks" => ["Delivery, adoption, and safety risks have not been declared in the idea interview."], "unanswered_decisions" => decisions.empty? ? ["No open product decision was declared; review the first capability before implementation."] : decisions},
    "domain_library" => {"kind" => "dora_domain_library", "version" => 1, "vocabulary" => concepts.each_with_index.map { |concept, index| {"id" => "concept-#{index + 1}", "description" => concept} }, "entities" => concepts.each_with_index.map { |concept, index| {"id" => "entity-#{index + 1}", "description" => concept} }, "invariants" => [{"id" => "declared-permission-intent", "description" => answers.fetch("permission_intent").to_s}], "permission_rules" => [{"id" => "declared-permission", "actor" => users.join(", "), "action" => answers.fetch("permission_intent").to_s, "boundary" => "Permission details require explicit review before implementation."}], "workflows" => [{"id" => "declared-workflow", "initial_state" => "not-declared", "transitions" => [{"from" => "not-declared", "to" => "review-required", "action" => answers.fetch("workflow_intent").to_s}]}], "acceptance_scenarios" => [{"id" => "first-capability-intent", "given" => answers.fetch("first_problem").to_s, "when" => capability.fetch("title"), "then" => first_work.fetch("observable_outcome")}]} ,
    "agent_profile" => {"kind" => "dora_agent_project_profile", "version" => 1, "entrypoints" => [{"id" => "agent-guide", "path" => "AGENTS.md", "purpose" => "Read project-specific working boundaries before changing the project."}], "canonical_knowledge" => [{"id" => "product-brief", "path" => "docs/product-brief.yaml", "purpose" => "Declared product intent and open decisions."}, {"id" => "domain-library", "path" => "docs/domain-library.yaml", "purpose" => "Declared domain terms, permissions, workflow intent, and acceptance intent."}], "stack_commands" => [{"id" => "control-check", "command" => "./bin/dora doctor .dora/project.yaml", "purpose" => "Validate declared Dora project controls."}], "authority_limits" => [{"id" => "external-changes", "rule" => "Do not publish, deploy, or change external state without explicit approval."}], "evidence_requirements" => [{"id" => "implementation", "rule" => "Record a passing leaf validation before marking a work item verified."}], "implementation_order" => [{"id" => "understand", "rule" => "Read canonical product and domain knowledge before planning a change."}, {"id" => "plan", "rule" => "Define one bounded observable work item before implementation."}, {"id" => "implement", "rule" => "Make the smallest change that satisfies the bounded item."}, {"id" => "verify", "rule" => "Run declared validation and retain its evidence."}]}
  }
end

def install_codex_integration(project_root)
  result = Dora::CodexIntegration.install!(project_root: project_root)
  return if emit_envelope(result, citations: ["AGENTS.md", ".dora/codex-integration/README.md"], side_effect: "local_mutation")

  puts "Dora Codex integration installed: #{File.expand_path(project_root)}."
rescue ArgumentError => error
  fail!(error.message)
end

def explain_subject(subject, path)
  result = case subject
           when "project" then Dora::Explain.project!(path)
           when "capability" then Dora::Explain.capability!(YAML.load_file(path))
           else fail!("explain subject must be project or capability")
           end
  return if emit_envelope(result, citations: result.fetch("citations"))

  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def show_next(adapter_path, inventory_path)
  adapter = YAML.load_file(adapter_path)
  root = File.expand_path(adapter.fetch("project").fetch("root"), File.dirname(File.expand_path(adapter_path)))
  result = Dora::AgentNext.next!(project_root: root, inventory_path: inventory_path)
  return if emit_envelope(result, citations: [result.fetch("citation")].compact)

  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError, KeyError, Psych::Exception => error
  fail!(error.message)
end

def diagnose_project_compact(adapter_path)
  result = Dora::ProjectDoctor.run(adapter_path, schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml"))
  payload = {"kind" => "dora_diagnosis", "version" => 1, "healthy" => result.fetch("healthy"), "blockers" => result.fetch("checks").select { |check| check.fetch("status") == "failed" }, "recommended_next_action" => result.fetch("healthy") ? "Use dora next with the declared execution inventory; it will not start work." : "Resolve the first listed failed check explicitly; diagnose does not repair it.", "completion_boundary" => "Diagnosis reports declared project checks only; it does not start work, repair files, or prove completion."}
  return if emit_envelope(payload, citations: [".dora/project.yaml"])

  puts YAML.dump(payload).sub(/\A---\n/, "")
end

def show_app_readiness(compatibility_path)
  result = Dora::StarterCompatibility.readiness!(compatibility_path)
  citation = compatibility_path.start_with?("/") ? File.basename(compatibility_path) : compatibility_path
  return if emit_envelope(result, citations: [citation])

  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def write_interview_session(path, session, overwrite: false)
  fail!("interview session already exists: #{path}") if File.exist?(path) && !overwrite
  FileUtils.mkdir_p(File.dirname(File.expand_path(path)))
  File.write(path, YAML.dump(session))
end

def start_interview_session(path, project_id)
  session = Dora::IdeaInterviewSession.new!(project_id: project_id)
  write_interview_session(path, session)
  return if emit_envelope({"session" => path, "next_question" => Dora::IdeaInterviewSession.next_question!(session), "completion_boundary" => "Starting an interview creates only its session file; it does not create product knowledge or implementation."}, citations: [File.basename(path)], side_effect: "local_mutation")
  puts "Dora interview session started: #{path}."
rescue ArgumentError => error
  fail!(error.message)
end

def show_interview_question(path)
  session = Dora::IdeaInterviewSession.load!(path)
  result = {"session" => path, "next_question" => Dora::IdeaInterviewSession.next_question!(session), "completion_boundary" => "This reports one declared question only; it does not infer an answer."}
  return if emit_envelope(result, citations: [File.basename(path)])
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

