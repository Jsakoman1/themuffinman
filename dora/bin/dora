def show_capability_trace(trace_path)
  trace = Dora::CapabilityTrace.load!(trace_path, project_root: Dir.pwd)
  citations = trace.fetch("capability").fetch("product_references") + trace.fetch("capability").fetch("domain_references") + [trace.fetch("work").fetch("plan")] + trace.fetch("implementation_references") + trace.fetch("validation_evidence").map { |entry| entry.fetch("path") } + trace.fetch("runtime_evidence").map { |entry| entry.fetch("path") }
  payload = trace.merge("citations" => citations.uniq)
  return if emit_envelope(payload, citations: citations.uniq)

  puts YAML.dump(payload).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def lease_citation(path)
  path.is_a?(String) && !path.start_with?("/") && !path.split("/").include?("..") ? [path] : []
end

def show_task_leases(path)
  report = Dora::TaskLease.inspect!(path)
  return if emit_envelope(report, citations: lease_citation(path))

  puts YAML.dump(report).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def handoff_option(arguments, name, required: true)
  index = arguments.index("--#{name}")
  value = index && arguments[index + 1]
  fail!("handoff option --#{name} is required") if required && (!value || value.start_with?("--"))
  value
end

def handoff_json_option(arguments, name)
  value = handoff_option(arguments, name, required: false)
  return nil unless value

  JSON.parse(value)
rescue JSON::ParserError
  fail!("handoff option --#{name} must contain a JSON object")
end

def execute_handoff(command, arguments)
  registry_path = arguments.shift
  fail!("handoff registry path is required") unless registry_path
  allowed = %w[state-root project id master-plan work-plan reason verification-plan verification-task feedback-json owner-decision-json completion-json]
  flags = arguments.each_slice(2).to_a
  fail!("handoff options are invalid") unless arguments.length.even? && flags.all? { |pair| pair.length == 2 && pair.first.start_with?("--") && allowed.include?(pair.first.delete_prefix("--")) }
  result = Dora::HandoffCLI.run!(command: command, registry_path: registry_path, state_root: handoff_option(arguments, "state-root"), project: handoff_option(arguments, "project"), id: handoff_option(arguments, "id", required: false), master_plan: handoff_option(arguments, "master-plan", required: false), work_plan: handoff_option(arguments, "work-plan", required: false), reason: handoff_option(arguments, "reason", required: false), verification_plan: handoff_option(arguments, "verification-plan", required: false), verification_task: handoff_option(arguments, "verification-task", required: false), feedback: handoff_json_option(arguments, "feedback-json"), owner_decision: handoff_json_option(arguments, "owner-decision-json"), completion_result: handoff_json_option(arguments, "completion-json"))
  puts YAML.dump(result || {"status" => "NO_READY_HANDOFF"}).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

