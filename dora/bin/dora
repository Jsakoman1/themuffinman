def record_interview_answer(path, id, value)
  session = Dora::IdeaInterviewSession.record_answer!(Dora::IdeaInterviewSession.load!(path), id: id, value: value)
  write_interview_session(path, session, overwrite: true)
  result = {"session" => path, "recorded_answer" => id, "next_question" => Dora::IdeaInterviewSession.next_question!(session), "completion_boundary" => "A recorded confirmed answer is interview context only; it does not resolve other decisions or authorize implementation."}
  return if emit_envelope(result, citations: [File.basename(path)], side_effect: "local_mutation")
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

