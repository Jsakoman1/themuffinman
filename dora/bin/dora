def diagnose_project(adapter_path)
  control_schema = File.join(ROOT, "project-control.schema.yaml")
  report = Dora::ProjectDoctor.run(adapter_path, schema_path: SCHEMA_PATH, control_schema_path: control_schema)
  report.fetch("checks").each { |check| puts "#{check.fetch("status").upcase} #{check.fetch("id")}: #{check.fetch("detail")}" }
  return if report.fetch("healthy")

  exit 1
end

