#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

ROOT = File.expand_path("..", __dir__)
SCHEMA_PATH = File.join(ROOT, "project-adapter.schema.yaml")
require File.join(ROOT, "lib/dora/adapter")
require File.join(ROOT, "lib/dora/work_verifier")
require File.join(ROOT, "lib/dora/work_execution")
require File.join(ROOT, "lib/dora/project_initializer")
require File.join(ROOT, "lib/dora/project_bootstrap")
require File.join(ROOT, "lib/dora/project_doctor")
require File.join(ROOT, "lib/dora/project_knowledge")
require File.join(ROOT, "lib/dora/agent_next")
require File.join(ROOT, "lib/dora/agent_closeout")
require File.join(ROOT, "lib/dora/project_status")
require File.join(ROOT, "lib/dora/plugin_discovery")
require File.join(ROOT, "lib/dora/command_registry")
require File.join(ROOT, "lib/dora/tool_selection_commands")
require File.join(ROOT, "lib/dora/discovery_commands")
require File.join(ROOT, "lib/dora/analysis_commands")
require File.join(ROOT, "lib/dora/project_configurator")
require File.join(ROOT, "lib/dora/control_commands")
require File.join(ROOT, "lib/dora/atomic_plan_contract")
require File.join(ROOT, "lib/dora/plan_coverage")
require File.join(ROOT, "lib/dora/plugin_contract")
require File.join(ROOT, "lib/dora/plugin_runner")

def fail!(message)
  warn "Dora adapter validation failed: #{message}"
  exit 1
end

def validate_adapter(path)
  result = Dora::Adapter.validate!(path, SCHEMA_PATH)
  puts "Dora adapter valid: #{result.fetch("project")} (#{result.fetch("extensions")} project extensions)."
rescue ArgumentError => error
  fail!(error.message)
end

def validate_work_plan(adapter_path, plan_path)
  result = Dora::WorkVerifier.validate_plan!(adapter_path, plan_path, SCHEMA_PATH)
  puts "Dora work plan valid: #{result.fetch("project")}##{result.fetch("id")} (#{result.fetch("kind")})."
rescue ArgumentError => error
  fail!(error.message)
end

def validate_atomic_plan_contract(plan_path)
  result = Dora::AtomicPlanContract.validate!(plan_path)
  puts "Dora atomic plan contract valid: #{result.fetch("id")} (#{result.fetch("tasks")} tasks)."
rescue ArgumentError => error
  fail!(error.message)
end

def review_plan_coverage(registry_path)
  Dora::PlanCoverage.review!(registry_path).each { |row| puts "#{row.fetch("id")}: #{row.fetch("status")} (#{row.fetch("path")})" }
rescue ArgumentError => error
  fail!(error.message)
end

def validate_plugin_contract(manifest_path)
  result = Dora::PluginContract.validate!(manifest_path)
  puts "Dora plugin contract valid: #{result.fetch("plugins").join(", ")}."
rescue ArgumentError => error
  fail!(error.message)
end

def run_plugin(manifest_path, plugin_id)
  result = Dora::PluginRunner.run!(manifest_path, plugin_id: plugin_id)
  puts result.fetch("output")
rescue ArgumentError => error
  fail!(error.message)
end

def execute_work(adapter_path, arguments)
  puts Dora::WorkExecution.run(adapter_path: adapter_path, schema_path: SCHEMA_PATH, arguments: arguments)
rescue Dora::WorkExecution::Error, ArgumentError => error
  fail!(error.message)
end

def initialize_project(destination, project_id, stack = nil, ci = nil, ci_commands = nil)
  manifest = File.join(ROOT, "templates/init-manifest.yaml")
  pack = stack && File.join(ROOT, "packs/#{stack}.yaml")
  ci_pack = ci && File.join(ROOT, "packs/#{ci}.yaml")
  fail!("unknown stack pack: #{stack}") if pack && !File.file?(pack)
  fail!("unknown CI pack: #{ci}") if ci_pack && !File.file?(ci_pack)
  files = Dora::ProjectInitializer.initialize!(destination, project_id: project_id, manifest_path: manifest, stack_pack_path: pack, ci_pack_path: ci_pack, ci_template_path: File.join(ROOT, "templates/github-actions-control.yml"), ci_commands_path: ci_commands)
  puts "Dora project initialized: #{File.expand_path(destination)} (#{files.length} control files)."
rescue ArgumentError => error
  fail!(error.message)
end

def bootstrap_project(destination, project_id, source_descriptor_path, starter = nil, ci = nil)
  starter_path = starter && File.join(ROOT, "starters", "#{starter}.yaml")
  fail!("unknown starter pack: #{starter}") if starter_path && !File.file?(starter_path)
  ci_path = ci && File.join(ROOT, "packs", "#{ci}.yaml")
  fail!("unknown CI pack: #{ci}") if ci_path && !File.file?(ci_path)
  result = Dora::ProjectBootstrap.bootstrap!(destination, project_id: project_id, source_descriptor_path: source_descriptor_path, starter_pack_path: starter_path, ci_pack_path: ci_path)
  puts "Dora project bootstrapped: #{result.fetch("project_root")} (#{result.fetch("package_path")} pinned to #{result.fetch("source_ref")})."
rescue ArgumentError => error
  fail!(error.message)
end

def diagnose_project(adapter_path)
  control_schema = File.join(ROOT, "project-control.schema.yaml")
  report = Dora::ProjectDoctor.run(adapter_path, schema_path: SCHEMA_PATH, control_schema_path: control_schema)
  report.fetch("checks").each { |check| puts "#{check.fetch("status").upcase} #{check.fetch("id")}: #{check.fetch("detail")}" }
  return if report.fetch("healthy")

  exit 1
end

def show_project_knowledge(adapter_path)
  adapter = YAML.load_file(adapter_path)
  root = File.expand_path(adapter.fetch("project").fetch("root"), File.dirname(File.expand_path(adapter_path)))
  puts YAML.dump(Dora::ProjectKnowledge.validate!(root)).sub(/\A---\n/, "")
rescue ArgumentError, KeyError, Psych::Exception => error
  fail!(error.message)
end

def show_agent_next(adapter_path, inventory_path)
  adapter = YAML.load_file(adapter_path)
  root = File.expand_path(adapter.fetch("project").fetch("root"), File.dirname(File.expand_path(adapter_path)))
  puts YAML.dump(Dora::AgentNext.next!(project_root: root, inventory_path: inventory_path)).sub(/\A---\n/, "")
rescue ArgumentError, KeyError, Psych::Exception => error
  fail!(error.message)
end

def show_agent_closeout(adapter_path, work_plan, task_id, impact_path, changed_paths)
  adapter = YAML.load_file(adapter_path)
  root = File.expand_path(adapter.fetch("project").fetch("root"), File.dirname(File.expand_path(adapter_path)))
  puts YAML.dump(Dora::AgentCloseout.review!(project_root: root, work_plan: work_plan, task_id: task_id, impact_path: impact_path, changed_paths: changed_paths)).sub(/\A---\n/, "")
rescue ArgumentError, KeyError, Psych::Exception => error
  fail!(error.message)
end

def show_project_status(adapter_path, inventory_path)
  puts YAML.dump(Dora::ProjectStatus.report!(adapter_path: adapter_path, inventory_path: inventory_path, adapter_schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml"))).sub(/\A---\n/, "")
rescue ArgumentError, KeyError, Psych::Exception => error
  fail!(error.message)
end

def show_plugin_discovery(manifest_path = nil)
  puts YAML.dump(Dora::PluginDiscovery.catalog!(manifest_path: manifest_path)).sub(/\A---\n/, "")
rescue ArgumentError, Psych::Exception => error
  fail!(error.message)
end

def show_help(adapter_path = nil)
  puts Dora::CommandRegistry.render(adapter_path: adapter_path, schema_path: SCHEMA_PATH)
rescue ArgumentError => error
  fail!(error.message)
end

def list_tools(adapter_path)
  Dora::ToolSelectionCommands.catalog(adapter_path, adapter_schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml")).each { |line| puts line }
rescue ArgumentError => error
  fail!(error.message)
end

def route_changes(adapter_path, paths)
  result = Dora::ToolSelectionCommands.route(adapter_path, paths, adapter_schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml"))
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def search_context(adapter_path, query)
  Dora::DiscoveryCommands.search(adapter_path, query, adapter_schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml")).each { |path| puts path }
rescue ArgumentError => error
  fail!(error.message)
end

def inventory_paths(adapter_path, paths)
  result = Dora::DiscoveryCommands.inventory(adapter_path, paths, adapter_schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml"))
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def review_evidence(adapter_path)
  result = Dora::AnalysisCommands.evidence(adapter_path, adapter_schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml"))
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def map_impact(adapter_path, ids)
  result = Dora::AnalysisCommands.impact(adapter_path, ids, adapter_schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml"))
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

def configure_control(adapter_path, control_id, source_path)
  result = Dora::ProjectConfigurator.apply!(adapter_path, control_id: control_id, source_path: source_path, adapter_schema_path: SCHEMA_PATH, control_schema_path: File.join(ROOT, "project-control.schema.yaml"))
  puts "Dora control configured: #{result}"
rescue ArgumentError => error
  fail!(error.message)
end

def control_result(method, adapter_path, config_path, *arguments)
  result = Dora::ControlCommands.public_send(method, adapter_path, config_path, *arguments, adapter_schema_path: SCHEMA_PATH)
  puts YAML.dump(result).sub(/\A---\n/, "")
rescue ArgumentError => error
  fail!(error.message)
end

command = ARGV.shift
case command
when "validate-adapter"
  fail!("usage: dora validate-adapter <adapter-path>") unless ARGV.length == 1
  validate_adapter(ARGV.first)
when "validate-work-plan"
  fail!("usage: dora validate-work-plan <adapter-path> <work-plan-path>") unless ARGV.length == 2
  validate_work_plan(ARGV[0], ARGV[1])
when "plan-contract"
  fail!("usage: dora plan-contract <work-plan-path>") unless ARGV.length == 1
  validate_atomic_plan_contract(ARGV.first)
when "plan-coverage"
  fail!("usage: dora plan-coverage <plan-registry-path>") unless ARGV.length == 1
  review_plan_coverage(ARGV.first)
when "plugin-contract"
  fail!("usage: dora plugin-contract <plugin-manifest-path>") unless ARGV.length == 1
  validate_plugin_contract(ARGV.first)
when "plugin-run"
  fail!("usage: dora plugin-run <plugin-manifest-path> <plugin-id>") unless ARGV.length == 2
  run_plugin(ARGV[0], ARGV[1])
when "work-start"
  fail!("usage: dora work-start <adapter-path> plan=<path> task=<id>") if ARGV.length < 3
  execute_work(ARGV.shift, ["action=start", *ARGV])
when "work-verify"
  fail!("usage: dora work-verify <adapter-path> plan=<path> [task=<id>]") if ARGV.length < 2
  execute_work(ARGV.shift, ARGV)
when "init"
  destination = ARGV.shift
  project_option = ARGV.index("--project")
  stack_option = ARGV.index("--stack")
  ci_option = ARGV.index("--ci")
  commands_option = ARGV.index("--commands")
  project_id = project_option ? ARGV[project_option + 1] : nil
  stack = stack_option ? ARGV[stack_option + 1] : nil
  ci = ci_option ? ARGV[ci_option + 1] : nil
  ci_commands = commands_option ? ARGV[commands_option + 1] : nil
  expected_length = 2 + (stack_option ? 2 : 0) + (ci_option ? 2 : 0) + (commands_option ? 2 : 0)
  fail!("usage: dora init <destination> --project <project-id> [--stack <stack-id>] [--ci <ci-id> --commands <project-commands.yaml>]") unless destination && project_option && ARGV.length == expected_length && project_id && (!stack_option || stack) && (!ci_option || ci) && (ci_option ? commands_option && ci_commands : !commands_option)
  initialize_project(destination, project_id, stack, ci, ci_commands)
when "bootstrap"
  destination = ARGV.shift
  project_option = ARGV.index("--project")
  source_option = ARGV.index("--source")
  starter_option = ARGV.index("--starter")
  ci_option = ARGV.index("--ci")
  project_id = project_option ? ARGV[project_option + 1] : nil
  source_descriptor_path = source_option ? ARGV[source_option + 1] : nil
  starter = starter_option ? ARGV[starter_option + 1] : nil
  ci = ci_option ? ARGV[ci_option + 1] : nil
  expected_length = 4 + (starter_option ? 2 : 0) + (ci_option ? 2 : 0)
  fail!("usage: dora bootstrap <destination> --project <project-id> --source <bootstrap-source.yaml> [--starter <starter-id>] [--ci <ci-pack>]") unless destination && project_option && source_option && ARGV.length == expected_length && project_id && source_descriptor_path && (!starter_option || starter) && (!ci_option || ci)
  bootstrap_project(destination, project_id, source_descriptor_path, starter, ci)
when "configure"
  adapter_path = ARGV.shift
  control_option = ARGV.index("--control")
  source_option = ARGV.index("--from")
  control_id = control_option ? ARGV[control_option + 1] : nil
  source_path = source_option ? ARGV[source_option + 1] : nil
  fail!("usage: dora configure <adapter-path> --control <control-id> --from <yaml-path>") unless adapter_path && control_option && source_option && ARGV.length == 4 && control_id && source_path
  configure_control(adapter_path, control_id, source_path)
when "retention", "cleanup-dry-run", "templates", "repository-map"
  adapter_path = ARGV.shift
  config_option = ARGV.index("--config")
  config_path = config_option ? ARGV[config_option + 1] : nil
  fail!("usage: dora #{command} <adapter-path> --config <path>") unless adapter_path && config_option == 0 && ARGV.length == 2 && config_path
  method = {"retention" => :retention, "cleanup-dry-run" => :cleanup_dry_run, "templates" => :template_freshness, "repository-map" => :repository_map}.fetch(command)
  control_result(method, adapter_path, config_path)
when "cleanup"
  adapter_path = ARGV.shift
  config_option = ARGV.index("--config")
  approve_option = ARGV.index("--approve")
  config_path = config_option ? ARGV[config_option + 1] : nil
  approved_paths = approve_option ? ARGV[(approve_option + 1)..] : []
  fail!("usage: dora cleanup <adapter-path> --config <path> --approve <path>...") unless adapter_path && config_option == 0 && approve_option == 2 && config_path && !approved_paths.empty?
  control_result(:cleanup_apply, adapter_path, config_path, approved_paths)
when "help"
  fail!("usage: dora help [adapter-path]") unless ARGV.length <= 1
  show_help(ARGV.first)
when "doctor"
  fail!("usage: dora doctor <adapter-path>") unless ARGV.length == 1
  diagnose_project(ARGV.first)
when "knowledge"
  fail!("usage: dora knowledge <adapter-path>") unless ARGV.length == 1
  show_project_knowledge(ARGV.first)
when "agent-next"
  fail!("usage: dora agent-next <adapter-path> <execution-inventory-path>") unless ARGV.length == 2
  show_agent_next(ARGV[0], ARGV[1])
when "agent-closeout"
  adapter_path = ARGV.shift
  work_plan = ARGV.shift
  task_id = ARGV.shift
  impact_path = ARGV.shift
  fail!("usage: dora agent-closeout <adapter-path> <work-plan-path> <task-id> <change-impact-path> <changed-path>...") unless adapter_path && work_plan && task_id && impact_path && !ARGV.empty?
  show_agent_closeout(adapter_path, work_plan, task_id, impact_path, ARGV)
when "status"
  fail!("usage: dora status <adapter-path> <execution-inventory-path>") unless ARGV.length == 2
  show_project_status(ARGV[0], ARGV[1])
when "plugins"
  fail!("usage: dora plugins [plugin-manifest-path]") unless ARGV.length <= 1
  show_plugin_discovery(ARGV.first)
when "tools"
  fail!("usage: dora tools <adapter-path>") unless ARGV.length == 1
  list_tools(ARGV.first)
when "route"
  adapter_path = ARGV.shift
  fail!("usage: dora route <adapter-path> <changed-path>...") unless adapter_path && !ARGV.empty?
  route_changes(adapter_path, ARGV)
when "search"
  adapter_path = ARGV.shift
  fail!("usage: dora search <adapter-path> <query>") unless adapter_path && ARGV.length == 1
  search_context(adapter_path, ARGV.first)
when "inventory"
  adapter_path = ARGV.shift
  fail!("usage: dora inventory <adapter-path> <path>...") unless adapter_path && !ARGV.empty?
  inventory_paths(adapter_path, ARGV)
when "evidence"
  fail!("usage: dora evidence <adapter-path>") unless ARGV.length == 1
  review_evidence(ARGV.first)
when "impact"
  adapter_path = ARGV.shift
  fail!("usage: dora impact <adapter-path> <node-id>...") unless adapter_path && !ARGV.empty?
  map_impact(adapter_path, ARGV)
else
  show_help
  exit 1
end
