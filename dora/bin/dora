  show_guided_agent_entrypoint(ARGV.first)
when "codex-context"
  fail!("usage: dora codex-context <codex-context-packet.yaml> [--format json|yaml]") unless ARGV.length == 1
  show_codex_context_packet(ARGV.first)
when "capability-graph"
  fail!("usage: dora capability-graph <domain-capability-graph.yaml> [--format json|yaml]") unless ARGV.length == 1
  show_domain_capability_graph(ARGV.first)
when "convention-check"
  fail!("usage: dora convention-check <project-convention-profile.yaml> <generated-feature-manifest.yaml> [--format json|yaml]") unless ARGV.length == 2
  show_project_convention_check(ARGV[0], ARGV[1])
when "proof-packet"
  fail!("usage: dora proof-packet <capability-proof-matrix.yaml> [--format json|yaml]") unless ARGV.length == 1
  show_capability_proof_packet(ARGV.first)
when "interview-answer"
  session_path = ARGV.shift
  id_option = ARGV.index("--id")
  value_option = ARGV.index("--value")
  id = id_option && ARGV[id_option + 1]
  value = value_option && ARGV[value_option + 1]
  fail!("usage: dora interview-answer <session.yaml> --id <answer-id> --value <user-confirmed-value> [--format json|yaml]") unless session_path && id && value && ARGV.length == 4
  record_interview_answer(session_path, id, value)
when "authoring-next"
  session_path = ARGV.shift
  readiness_option = ARGV.index("--readiness")
  readiness_path = readiness_option && ARGV[readiness_option + 1]
  fail!("usage: dora authoring-next <session.yaml> [--readiness <starter-compatibility.yaml>] [--format json|yaml]") unless session_path && (!readiness_option || ARGV.length == 2)
  show_authoring_next(session_path, readiness_path)
when "vertical-slice"
  fail!("usage: dora vertical-slice <confirmed-capability-context.yaml> [--format json|yaml]") unless ARGV.length == 1
  show_vertical_slice(ARGV.first)
when "decision-record"
  path = ARGV.shift
  fail!("usage: dora decision-record <log.yaml> --id <id> --decision <text> --status <proposed|accepted|superseded> --domain-ref <path> --plan-ref <path> --evidence-ref <path> [--format json|yaml]") unless path && ARGV.length == 12
  append_decision_record(path, ARGV)
when "runtime-profile-apply"
  destination = ARGV.shift
  dry_run = ARGV.delete("--dry-run")
  apply = ARGV.delete("--apply")
  fail!("usage: dora runtime-profile-apply <relative-destination> --dry-run|--apply [--format json|yaml]") unless destination && ARGV.empty? && (!!dry_run ^ !!apply)
  apply_runtime_profile(destination, !dry_run.nil?)
when "evidence-explain"
  fail!("usage: dora evidence-explain <revision-evidence-trace.yaml> [--format json|yaml]") unless ARGV.length == 1
  explain_revision_evidence(ARGV.first)
when "bootstrap"
  destination = ARGV.shift
  project_option = ARGV.index("--project")
  source_option = ARGV.index("--source")
  starter_option = ARGV.index("--starter")
  ci_option = ARGV.index("--ci")
  project_id = project_option ? ARGV[project_option + 1] : nil
  source_descriptor_path = source_option ? ARGV[source_option + 1] : nil
  starter = starter_option ? ARGV[starter_option + 1] : nil
  ci = ci_option ? ARGV[ci_option + 1] : nil
  expected_length = 4 + (starter_option ? 2 : 0) + (ci_option ? 2 : 0)
  fail!("usage: dora bootstrap <destination> --project <project-id> --source <bootstrap-source.yaml> [--starter <starter-id>] [--ci <ci-pack>]") unless destination && project_option && source_option && ARGV.length == expected_length && project_id && source_descriptor_path && (!starter_option || starter) && (!ci_option || ci)
  bootstrap_project(destination, project_id, source_descriptor_path, starter, ci)
when "upgrade-preview"
  project_root = ARGV.shift
  source_option = ARGV.index("--source")
  source_descriptor_path = source_option ? ARGV[source_option + 1] : nil
  fail!("usage: dora upgrade-preview <consumer-root> --source <bootstrap-source.yaml>") unless project_root && source_option == 0 && ARGV.length == 2 && source_descriptor_path
  preview_project_upgrade(project_root, source_descriptor_path)
when "upgrade-apply"
  project_root = ARGV.shift
  source_option = ARGV.index("--source"); approval_option = ARGV.index("--approval")
  source = source_option && ARGV[source_option + 1]; approval = approval_option && ARGV[approval_option + 1]
  fail!("usage: dora upgrade-apply <consumer-root> --source <bootstrap-source.yaml> --approval <approval-record.yaml>") unless project_root && source && approval
  apply_project_upgrade(project_root, source, approval)
when "upgrade-rollback"
  project_root = ARGV.shift
  backup_option = ARGV.index("--backup"); approval_option = ARGV.index("--approval")
  backup = backup_option && ARGV[backup_option + 1]; approval = approval_option && ARGV[approval_option + 1]
  fail!("usage: dora upgrade-rollback <consumer-root> --backup <recorded-backup-path> --approval <approval-record.yaml>") unless project_root && backup && approval
  rollback_project_upgrade(project_root, backup, approval)
when "configure"
  adapter_path = ARGV.shift
  control_option = ARGV.index("--control")
  source_option = ARGV.index("--from")
  control_id = control_option ? ARGV[control_option + 1] : nil
  source_path = source_option ? ARGV[source_option + 1] : nil
  fail!("usage: dora configure <adapter-path> --control <control-id> --from <yaml-path>") unless adapter_path && control_option && source_option && ARGV.length == 4 && control_id && source_path
  configure_control(adapter_path, control_id, source_path)
when "retention", "cleanup-dry-run", "templates", "repository-map"
  adapter_path = ARGV.shift
  config_option = ARGV.index("--config")
  config_path = config_option ? ARGV[config_option + 1] : nil
  fail!("usage: dora #{command} <adapter-path> --config <path>") unless adapter_path && config_option == 0 && ARGV.length == 2 && config_path
  method = {"retention" => :retention, "cleanup-dry-run" => :cleanup_dry_run, "templates" => :template_freshness, "repository-map" => :repository_map}.fetch(command)
  control_result(method, adapter_path, config_path)
when "cleanup"
  adapter_path = ARGV.shift
  config_option = ARGV.index("--config")
  approve_option = ARGV.index("--approve")
  config_path = config_option ? ARGV[config_option + 1] : nil
  approved_paths = approve_option ? ARGV[(approve_option + 1)..] : []
  fail!("usage: dora cleanup <adapter-path> --config <path> --approve <path>...") unless adapter_path && config_option == 0 && approve_option == 2 && config_path && !approved_paths.empty?
  control_result(:cleanup_apply, adapter_path, config_path, approved_paths)
when "help"
  fail!("usage: dora help [adapter-path]") unless ARGV.length <= 1
  show_help(ARGV.first)
when "doctor"
  fail!("usage: dora doctor <adapter-path>") unless ARGV.length == 1
  diagnose_project(ARGV.first)
when "readiness"
  project_root = ARGV.shift
  initialize_git = ARGV.delete("--initialize-git")
  fail!("usage: dora readiness <project-root> [--initialize-git]") unless project_root && ARGV.empty?
  show_project_readiness(project_root, initialize_git: !initialize_git.nil?)
when "memory-refresh"
  fail!("usage: dora memory-refresh <project-root> [--format json|yaml]") unless ARGV.length == 1
  show_memory_refresh(ARGV.first)
when "capability-trace"
  fail!("usage: dora capability-trace <trace-path> [--format json|yaml]") unless ARGV.length == 1
  show_capability_trace(ARGV.first)
when "lease-inspect"
  fail!("usage: dora lease-inspect <lease-registry-path> [--format json|yaml]") unless ARGV.length == 1
  show_task_leases(ARGV.first)
when "lease-acquire"
  registry_path = ARGV.shift
  work_plan = ARGV.shift
  task = ARGV.shift
  holder = ARGV.shift
  expires_option = ARGV.index("--expires-at")
  expires_at = expires_option && ARGV[expires_option + 1]
  fail!("usage: dora lease-acquire <lease-registry-path> <work-plan> <task> <holder> --expires-at <ISO-8601>") unless registry_path && work_plan && task && holder && expires_option == 0 && ARGV.length == 2 && expires_at
  acquire_task_lease(registry_path, work_plan, task, holder, expires_at)
when "lease-handoff"
  registry_path = ARGV.shift
  lease_id = ARGV.shift
  holder = ARGV.shift
  reason_option = ARGV.index("--reason")
  reason = reason_option && ARGV[reason_option + 1]
  fail!("usage: dora lease-handoff <lease-registry-path> <lease-id> <holder> --reason <reason>") unless registry_path && lease_id && holder && reason_option == 0 && ARGV.length == 2 && reason
  handoff_task_lease(registry_path, lease_id, holder, reason)
when "knowledge"
  fail!("usage: dora knowledge <adapter-path>") unless ARGV.length == 1
  show_project_knowledge(ARGV.first)
when "agent-next"
  fail!("usage: dora agent-next <adapter-path> <execution-inventory-path>") unless ARGV.length == 2
  show_agent_next(ARGV[0], ARGV[1])
when "agent-context"
  fail!("usage: dora agent-context <adapter-path> <work-plan-path> <task-id>") unless ARGV.length == 3
  show_agent_context(ARGV[0], ARGV[1], ARGV[2])
when "agent-session"
  fail!("usage: dora agent-session <adapter-path> <execution-inventory-path> <work-plan-path> <task-id> [--format json|yaml]") unless ARGV.length == 4
  show_agent_session(ARGV[0], ARGV[1], ARGV[2], ARGV[3])
when "agent-closeout"
  adapter_path = ARGV.shift
  work_plan = ARGV.shift
  task_id = ARGV.shift
  impact_path = ARGV.shift
  fail!("usage: dora agent-closeout <adapter-path> <work-plan-path> <task-id> <change-impact-path> <changed-path>...") unless adapter_path && work_plan && task_id && impact_path && !ARGV.empty?
  show_agent_closeout(adapter_path, work_plan, task_id, impact_path, ARGV)
when "status"
  fail!("usage: dora status <adapter-path> <execution-inventory-path>") unless ARGV.length == 2
  show_project_status(ARGV[0], ARGV[1])
when "findings-export"
  fail!("usage: dora findings-export <plugin-report.json>") unless ARGV.length == 1
  show_finding_export(ARGV.first)
when "plugins"
  fail!("usage: dora plugins [plugin-manifest-path]") unless ARGV.length <= 1
  show_plugin_discovery(ARGV.first)
when "tools"
  fail!("usage: dora tools <adapter-path>") unless ARGV.length == 1
  list_tools(ARGV.first)
when "route"
  adapter_path = ARGV.shift
  fail!("usage: dora route <adapter-path> <changed-path>...") unless adapter_path && !ARGV.empty?
  route_changes(adapter_path, ARGV)
when "search"
  adapter_path = ARGV.shift
  fail!("usage: dora search <adapter-path> <query>") unless adapter_path && ARGV.length == 1
  search_context(adapter_path, ARGV.first)
when "inventory"
  adapter_path = ARGV.shift
  fail!("usage: dora inventory <adapter-path> <path>...") unless adapter_path && !ARGV.empty?
  inventory_paths(adapter_path, ARGV)
when "evidence"
  fail!("usage: dora evidence <adapter-path>") unless ARGV.length == 1
  review_evidence(ARGV.first)
when "impact"
  adapter_path = ARGV.shift
  fail!("usage: dora impact <adapter-path> <node-id>...") unless adapter_path && !ARGV.empty?
  map_impact(adapter_path, ARGV)
else
  show_help
  exit 1
end
