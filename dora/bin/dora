  explain_subject(ARGV[0], ARGV[1])
when "next"
  fail!("usage: dora next <adapter-path> <execution-inventory-path> [--format json|yaml]") unless ARGV.length == 2
  show_next(ARGV[0], ARGV[1])
when "diagnose"
  fail!("usage: dora diagnose <adapter-path> [--format json|yaml]") unless ARGV.length == 1
  diagnose_project_compact(ARGV.first)
when "app-readiness"
  fail!("usage: dora app-readiness <starter-compatibility.yaml> [--format json|yaml]") unless ARGV.length == 1
  show_app_readiness(ARGV.first)
when "interview-start"
  session_path = ARGV.shift
  project_option = ARGV.index("--project")
  project_id = project_option && ARGV[project_option + 1]
  fail!("usage: dora interview-start <session.yaml> --project <project-id> [--format json|yaml]") unless session_path && project_option == 0 && ARGV.length == 2 && project_id
  start_interview_session(session_path, project_id)
when "interview-next"
  fail!("usage: dora interview-next <session.yaml> [--format json|yaml]") unless ARGV.length == 1
  show_interview_question(ARGV.first)
when "guided-next"
