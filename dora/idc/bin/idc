#!/usr/bin/env ruby
# frozen_string_literal: true

ROOT = File.expand_path("..", __dir__)
require File.join(ROOT, "lib/idc/request")
require File.join(ROOT, "lib/idc/dossier")

def usage!; warn "usage: idc render --request <path> --manifest <path> --dossier <path> --out <path>"; exit 1; end
def option(arguments, name); index = arguments.index(name); usage! unless index && arguments[index + 1]; arguments[index + 1]; end
def output_path!(path); usage! unless path.is_a?(String) && !path.strip.empty? && !File.directory?(path); raise ArgumentError, "output directory does not exist" unless Dir.exist?(File.dirname(File.expand_path(path))); path; end

begin
  command = ARGV.shift
  usage! unless command == "render" && ARGV.length == 8
  raise ArgumentError, "input options must be unique" unless %w[--request --manifest --dossier --out].all? { |flag| ARGV.count(flag) == 1 }
  request = Idc::Request.load!(option(ARGV, "--request"), label: "request")
  manifest = Idc::Request.load!(option(ARGV, "--manifest"), label: "manifest")
  dossier = Idc::Request.load!(option(ARGV, "--dossier"), label: "dossier")
  out_path = output_path!(option(ARGV, "--out"))
  File.write(out_path, Idc::Dossier.render(request: request, manifest: manifest, dossier: dossier))
  puts "IDC advisory dossier rendered: #{out_path}"
rescue ArgumentError => error
  warn "IDC validation failed: #{error.message}"
  exit 1
end
